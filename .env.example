DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
# Leave unset/false for local HTTP; enable HTTPS redirect behind TLS in production.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
# For MySQL, set DB_ENGINE=mysql and configure these values:
# DB_NAME=library_db1
# DB_USER=library_user
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=3306
